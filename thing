<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>COD3S</title>
<style>
    :root{
        --bg1:#1e1e2f;
        --bg2:#3a3a5c;
        --accent:#ff8c00;
        --accent-2:#ff4500;
        --neon:#00ffff;
        --panel: rgba(255,255,255,0.06);
    }

    html,body{
        height:100%;
        margin:0;
    }

    body{
        display:flex;
        flex-direction:column;
        justify-content:center;
        align-items:center;
        font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, var(--bg1), var(--bg2));
        color:#fff;
        overflow:hidden; /* nested iframes will handle their own overflow */
    }

    h1{
        font-size:5rem;
        margin:0 0 40px 0;
        text-align:center;
        line-height:1;
        text-shadow: 2px 2px 10px var(--accent), 0 0 20px var(--accent-2);
    }

    .input-container{
        display:flex;
        align-items:center;
        gap:20px;
        position:relative;
    }

    input[type="text"]{
        padding:15px;
        font-size:1.5rem;
        width:300px;
        text-align:center;
        border:2px solid var(--accent);
        border-radius:12px;
        outline:none;
        background: var(--panel);
        color:#fff;
        transition:0.25s;
    }

    input[type="text"]:focus{
        border-color:var(--accent-2);
        box-shadow:0 0 10px var(--accent-2);
    }

    button{
        padding:12px 25px;
        font-size:1.2rem;
        border:none;
        border-radius:10px;
        background:var(--accent);
        color:#fff;
        cursor:pointer;
        transition:0.25s;
        box-shadow:0 0 10px var(--accent);
    }

    button:hover{
        background:var(--accent-2);
        box-shadow:0 0 15px var(--accent-2);
    }

    p{
        margin-top:20px;
        font-size:1rem;
        color:#ddd;
        text-align:center;
    }

    #output{
        margin-top:30px;
        font-size:1.5rem;
        min-height:50px;
        text-align:center;
        color:var(--neon);
        text-shadow:0 0 5px var(--neon);
    }

    /* Carrot */
    #carrotImage{
        width:220px;
        height:220px;
        cursor:pointer;
        display:none;
        position:absolute;
        left:-400px;
        top:50%;
        transform:translateY(-50%);
    }

    /* COD3S Page secret container (positioned relative to screen center) */
    #cod3sContainer{
        position:absolute;
        display:none;
        top:50%;
        left:50%;
        transform:translate(400px, -50%);
    }

    #cod3sImage{
        width:255px;
        height:300px;
        cursor:pointer;
        display:block;
        position:relative;
    }

    #cod3sText{
        position:absolute;
        top:50%;
        left:50%;
        transform:translate(-50%,-50%);
        width:90%;
        text-align:center;
        font-size:1rem;
        color:#fff;
        text-shadow:1px 1px 5px #000;
        pointer-events:none;
    }

    /* TVtime player (top-left) */
    #tvContainer{
        position:fixed;
        top:20px;
        left:20px;
        display:none;
        flex-direction:column;
        align-items:center;
        gap:8px;
        background: rgba(30,30,47,0.9);
        padding:10px;
        border-radius:12px;
        box-shadow:0 0 15px rgba(0,0,0,0.7);
        z-index:9999;
    }

    #tvContainer video{
        width:320px;
        height:180px;
        border-radius:8px;
        border:2px solid var(--accent);
        background:black;
    }

    .tv-controls{
        display:flex;
        gap:10px;
    }

    .tv-controls button{
        background:var(--accent);
        box-shadow:0 0 10px var(--accent);
        border:none;
        border-radius:8px;
        padding:6px 14px;
        color:#fff;
        font-weight:600;
        cursor:pointer;
    }

    .tv-controls button:hover{
        background:var(--accent-2);
        box-shadow:0 0 15px var(--accent-2);
    }

    /* Recursive mini-screen (bottom-right aligned). Each page will render its own mini if needed */
    .mini-screen{
        position:fixed;
        right:20px;
        bottom:20px;
        width:320px;
        height:180px;
        border-radius:8px;
        overflow:hidden;
        border:3px solid rgba(255,255,255,0.06);
        box-shadow: 0 8px 24px rgba(0,0,0,0.6);
        z-index:9998;
        background:black;
    }

    .mini-screen iframe{
        width:100%;
        height:100%;
        border:0;
        display:block;
    }

    /* When nested iframes create their own mini-screen, it'll still be bottom-right inside that iframe's viewport */
</style>
</head>
<body>
    <h1>COD3S</h1>

    <div class="input-container">
        <img id="carrotImage" src="https://file.garden/Z-CUTZ9vlwLEFzWU/CarrotSticker.png" alt="Carrot Sticker">
        <input type="text" id="inputBox" placeholder="Type something..." />
        <button id="goButton">Go</button>
    </div>

    <p>Type Cool things and cool things appear! Here's a code: Carrot</p>
    <div id="output"></div>

    <!-- Carrot sound -->
    <audio id="carrotSound" src="https://file.garden/Z-CUTZ9vlwLEFzWU/Carrot.mp3"></audio>

    <!-- COD3S Page secret -->
    <div id="cod3sContainer">
        <img id="cod3sImage" src="https://file.garden/Z-CUTZ9vlwLEFzWU/Page.png" alt="COD3S Page">
        <div id="cod3sText"></div>
    </div>

    <!-- TVtime player -->
    <div id="tvContainer" aria-hidden="true">
        <video id="tvPlayer" controls>
            <source src="" type="video/mp4">
            Your browser does not support the video tag.
        </video>
        <div class="tv-controls">
            <button id="prevVideo">Previous</button>
            <button id="nextVideo">Next</button>
        </div>
    </div>

<script>
/* ====== CONFIG ====== */
const MAX_DEPTH = 5; // stop after this many levels (main page = depth 0)

/* ====== read current depth from URL param (if any) ====== */
const urlParams = new URLSearchParams(window.location.search);
const currentDepth = Number(urlParams.get('depth') || 0);

/* ====== elements (common) ====== */
const goButton = document.getElementById('goButton');
const inputBox = document.getElementById('inputBox');
const outputDiv = document.getElementById('output');

const carrotImage = document.getElementById('carrotImage');
const carrotSound = document.getElementById('carrotSound');
let carrotFound = false;

const cod3sContainer = document.getElementById('cod3sContainer');
const cod3sImage = document.getElementById('cod3sImage');
const cod3sText = document.getElementById('cod3sText');

const tvContainer = document.getElementById('tvContainer');
const tvPlayer = document.getElementById('tvPlayer');
const nextVideoBtn = document.getElementById('nextVideo');
const prevVideoBtn = document.getElementById('prevVideo');

/* ====== data pools ====== */
const cod3sTexts = [
    "I like carrots",
    "Did you know?  Geometry Dash was inspired by the true story of a man named Joe Metri Dash, who was forced to jump over spikes in an arena for the entertainment of a crowd.",
    "This is a placholder!",
    "Webi wabu",
    "What. (By Spunix)",
    "gstgd iaaue tfgtytidtuasgt  ay ygu gt e4674 eie47 egsgaia e1111111111111",
    "I like car",
    "Whoa stop right there pal, ur clicking too good.",
    "This program Was brought to you by Blocky's Funny Doings International.",
    "insert text here",
    "Psst, Type gullible for a free Code!",
    "Hey, By the way, type TVtime for some entretainment!"
];

const videos = [
    "https://file.garden/Z-CUTZ9vlwLEFzWU/Minecraft%20parkour%20gameplay%201%20minute.mp4",
    "https://file.garden/Z-CUTZ9vlwLEFzWU/Top%205%20Top%205%20Scariest%20Jumpscares.mp4",
    "https://file.garden/Z-CUTZ9vlwLEFzWU/Anarchy%20Chess_%20Reddit's%20Greatest%20Sh_tpost.mp4",
    "https://file.garden/Z-CUTZ9vlwLEFzWU/BFDI%201a_%20Take%20the%20Plunge.mp4",
    "https://file.garden/Z-CUTZ9vlwLEFzWU/Nothing%20Beats%20a%20Jet2holiday%20_%20Sale%20_%20Family%20_%20TV%20advert.mp4",
    "https://file.garden/Z-CUTZ9vlwLEFzWU/A%20Podcast%20That%20Makes%20The%20Sign%20Guy%20Say%20Something%20Different.mp4"
];

let cod3sLastIndex = -1;
let currentVideo = 0;

/* ====== utility functions ====== */
function getRandomCod3sText(){
    if(cod3sTexts.length === 1) return cod3sTexts[0];
    let i;
    do {
        i = Math.floor(Math.random() * cod3sTexts.length);
    } while (i === cod3sLastIndex);
    cod3sLastIndex = i;
    return cod3sTexts[i];
}

function playVideo(index){
    if(index < 0 || index >= videos.length) return;
    currentVideo = index;
    tvPlayer.src = videos[currentVideo];
    // try to play (may be blocked until user interacts in some browsers)
    const playPromise = tvPlayer.play();
    if(playPromise && playPromise.catch) playPromise.catch(()=>{ /* autoplay prevented - user can click play */ });
}

/* ====== TV controls ====== */
nextVideoBtn?.addEventListener('click', ()=>{
    currentVideo = (currentVideo + 1) % videos.length;
    playVideo(currentVideo);
});
prevVideoBtn?.addEventListener('click', ()=>{
    currentVideo = (currentVideo - 1 + videos.length) % videos.length;
    playVideo(currentVideo);
});

/* ====== Mini-screen creation (returns element) ====== */
let miniCreated = false;
function createMiniScreen(depthToCreate){
    // guard
    if(miniCreated) return null;
    miniCreated = true;

    const container = document.createElement('div');
    container.className = 'mini-screen';

    // Build src pointing to same origin+path but with depth param
    const nextDepth = depthToCreate; // expected to be 1..MAX_DEPTH
    const base = location.origin + location.pathname;
    const src = base + '?depth=' + encodeURIComponent(nextDepth);

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = 'Mini screen (depth ' + nextDepth + ')';
    iframe.loading = 'eager';
    container.appendChild(iframe);

    document.body.appendChild(container);
    return container;
}

/* ====== Behavior when user types codes in main page (depth 0) ====== */
function handleInput(){
    const raw = inputBox.value;
    const userInput = (raw === null) ? '' : raw.trim();

    // Carrot (case-insensitive)
    if(/^carrot$/i.test(userInput)){
        carrotFound = true;
    }
    if(carrotFound){
        carrotImage.style.display = 'block';
        outputDiv.textContent = 'You found the Carrot!';
    } else {
        outputDiv.textContent = '';
    }

    // COD3S (exact capitalization)
    if(userInput === 'COD3S'){
        cod3sContainer.style.display = 'block';
        cod3sText.textContent = getRandomCod3sText();
    }

    // TVtime (exact)
    if(userInput === 'TVtime'){
        tvContainer.style.display = 'flex';
        playVideo(currentVideo);
    }

    // Recursive mini-screen trigger (exact match: "Type something...")
    if(userInput === 'Type something...'){
        // only main page (depth 0) should create the first mini-screen on user action
        if(currentDepth === 0){
            // create depth 1 iframe — that iframe (on load) will auto-create depth 2, etc.
            createMiniScreen(1);
        }
    }

    inputBox.value = '';
}

/* ====== When running inside an iframe with ?depth=N, auto-create the next mini up to MAX_DEPTH ====== */
function autoCreateNestedMini(){
    // Only create nested minis when the page is loaded inside an iframe with depth param >=1
    if(currentDepth >= 1 && currentDepth < MAX_DEPTH){
        // create the next depth for this document's viewport
        // Note: createMiniScreen will insert a mini-screen into THIS document's bottom-right
        // but we need to pass nextDepth = currentDepth + 1 so the child iframe knows its depth
        // To avoid race conditions allow a tiny timeout
        setTimeout(()=>{
            // reset miniCreated flag for this document (it is per-document)
            miniCreated = false;
            createMiniScreen(currentDepth + 1);
        }, 120); // small delay so the page finishes painting
    }
}

/* ====== Setup: wire up events depending on depth ====== */
if(currentDepth === 0){
    // main page: wire input and buttons
    goButton.addEventListener('click', handleInput);
    inputBox.addEventListener('keydown', (e)=>{
        if(e.key === 'Enter') handleInput();
    });

    // carrot click plays sound
    carrotImage.addEventListener('click', ()=>{
        carrotSound.currentTime = 0;
        carrotSound.play();
    });

    // cod3s image click cycles text
    cod3sImage.addEventListener('click', ()=>{
        cod3sText.textContent = getRandomCod3sText();
    });

    // if page is loaded with ?depth=0 but embedded inside other context, still ok
} else {
    // pages inside iframes (depth >=1)
    // auto-create nested mini-screen (so the nesting appears automatically)
    window.addEventListener('DOMContentLoaded', ()=>{
        // Make sure the mini-screen inside an iframe can also respond to codes if someone types inside it,
        // but we also auto-create the next layer up to MAX_DEPTH
        // hook up local behavior: allow internal input handling inside the iframe too
        const localGo = document.getElementById('goButton');
        const localInput = document.getElementById('inputBox');
        const localCarrot = document.getElementById('carrotImage');
        const localCarrotSound = document.getElementById('carrotSound');
        const localCod3sImage = document.getElementById('cod3sImage');
        const localCod3sText = document.getElementById('cod3sText');
        const localTvContainer = document.getElementById('tvContainer');
        const localTvPlayer = document.getElementById('tvPlayer');

        // local handlers: reuse same functions but scoped to this document
        if(localGo){
            localGo.addEventListener('click', handleInput);
        }
        if(localInput){
            localInput.addEventListener('keydown', (e)=>{
                if(e.key === 'Enter') handleInput();
            });
        }
        if(localCarrot && localCarrotSound){
            localCarrot.addEventListener('click', ()=>{ localCarrotSound.currentTime = 0; localCarrotSound.play(); });
        }
        if(localCod3sImage && localCod3sText){
            localCod3sImage.addEventListener('click', ()=>{ localCod3sText.textContent = getRandomCod3sText(); });
        }

        // TVtime: wire local controls if present
        const localNext = document.getElementById('nextVideo');
        const localPrev = document.getElementById('prevVideo');
        if(localNext){
            localNext.addEventListener('click', ()=>{
                currentVideo = (currentVideo + 1) % videos.length;
                localTvPlayer.src = videos[currentVideo];
                localTvPlayer.play().catch(()=>{});
            });
        }
        if(localPrev){
            localPrev.addEventListener('click', ()=>{
                currentVideo = (currentVideo - 1 + videos.length) % videos.length;
                localTvPlayer.src = videos[currentVideo];
                localTvPlayer.play().catch(()=>{});
            });
        }

        // finally auto create nested mini-screen if allowed
        autoCreateNestedMini();
    });
}

/* Ensure main page still auto-creates nested minis if it loads with a depth param (edge-case) */
if(currentDepth === 0){
    // just in case someone opened the main page with ?depth=0, don't auto-create nesting
}

/* If the page is an iframe at depth>=1 it will auto-create nested mini-screens
   up to MAX_DEPTH. The initial user action is required only on the main page (depth 0). */

</script>
</body>
</html>
